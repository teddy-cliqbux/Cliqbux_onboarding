{
  "name": "MerchantAccount",
  "type": "object",
  "description": "Tier-1 merchant parent (HubSpot Corporation company). Multiple deals (MerchantCorporateProfile.corporateId = HubSpot dealId) and multiple TINs (legalEntities) hang under one account. Continuity home for legal entities and people KYC across signings. See AGENTS.md / AI_CHANNEL 2026-07-18 grill.",
  "properties": {
    "hubspotCompanyId": {
      "type": "string",
      "description": "HubSpot Tier-1 Corporation company id \u2014 primary external identity for this account"
    },
    "name": {
      "type": "string",
      "description": "Corporation / group display name (matches HubSpot company name at create time)"
    },
    "domain": {
      "type": "string",
      "description": "Optional company domain from HubSpot or primary signer email"
    },
    "primaryContactEmail": {
      "type": "string",
      "description": "Normalized owner/operator contact email \u2014 used to link MSP portfolio sync and multi-EIN parents (Parent \u2192 Legal Entity \u2192 Location)"
    },
    "primaryContactName": {
      "type": "string",
      "description": "Owner/operator display name from MSP contact or HubSpot"
    },
    "legalEntities": {
      "type": "array",
      "description": "Multi-EIN legal entities owned by this account \u2014 reusable across deals. Source of truth when merchantAccountId is set on a profile; profile.legalEntities is mirrored for boarding compatibility.",
      "items": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "description": "UUID \u2014 unique identifier for this legal entity"
          },
          "legalBusinessName": {
            "type": "string"
          },
          "tradeNameDBA": {
            "type": "string"
          },
          "federalEIN": {
            "type": "string",
            "description": "Tax ID digits \u2014 EIN for entities, or SSN for sole props (see taxIdType)"
          },
          "taxIdType": {
            "type": "string",
            "description": "EIN for corporations/LLCs; SSN for sole proprietors",
            "enum": [
              "EIN",
              "SSN"
            ]
          },
          "mailingStreet": {
            "type": "string"
          },
          "mailingStreet2": {
            "type": "string",
            "description": "Optional apt / suite / unit for legal address"
          },
          "mailingCity": {
            "type": "string"
          },
          "mailingState": {
            "type": "string"
          },
          "mailingZip": {
            "type": "string"
          },
          "legalAddressSameAsStore": {
            "type": "boolean"
          },
          "correspondenceStreet": {
            "type": "string"
          },
          "correspondenceStreet2": {
            "type": "string",
            "description": "Optional apt / suite / unit for correspondence address"
          },
          "correspondenceCity": {
            "type": "string"
          },
          "correspondenceState": {
            "type": "string"
          },
          "correspondenceZip": {
            "type": "string"
          },
          "corporateMailingAddress": {
            "type": "string"
          },
          "ownershipType": {
            "type": "string"
          },
          "taxClassType": {
            "type": "string"
          },
          "establishmentYear": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name"
  ]
}